# Copy to .env and fill in. .env is gitignored; never commit real values.

# Telegram: create a bot with @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Operator chat id (Yus). Account-discovery suggestions and source alerts go here.
# Defaults to TELEGRAM_CHAT_ID if unset.
TELEGRAM_OPERATOR_CHAT_ID=

# Search provider for Source B. One of: google_cse, brave, none
SEARCH_PROVIDER=google_cse

# Google Custom Search JSON API (100 queries/day free)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=

# Brave Search API (alternative, independent index)
BRAVE_API_KEY=
